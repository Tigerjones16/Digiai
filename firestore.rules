rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'createdAt']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt']) &&
             data.uid == request.auth.uid &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidBookmark(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'articleId', 'title', 'createdAt']) &&
             data.keys().hasOnly(['id', 'userId', 'articleId', 'title', 'sourceUrl', 'category', 'createdAt']) &&
             data.userId == userId &&
             data.id is string && isValidId(data.id) &&
             data.articleId is string && data.articleId.size() <= 128 &&
             data.title is string && data.title.size() <= 300 &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             (!('sourceUrl' in data) || (data.sourceUrl is string && data.sourceUrl.size() <= 500)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 50));
    }

    function isValidFormLink(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'formId', 'title', 'createdAt']) &&
             data.keys().hasOnly(['id', 'userId', 'formId', 'title', 'responderUri', 'editUri', 'description', 'createdAt']) &&
             data.userId == userId &&
             data.id is string && isValidId(data.id) &&
             data.formId is string && data.formId.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             (!('responderUri' in data) || (data.responderUri is string && data.responderUri.size() <= 500)) &&
             (!('editUri' in data) || (data.editUri is string && data.editUri.size() <= 500)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 500));
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data) &&
                    request.resource.data.uid == resource.data.uid &&
                    request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /bookmarks/{bookmarkId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(bookmarkId) && isValidBookmark(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidId(bookmarkId) && isValidBookmark(request.resource.data, userId) &&
                      request.resource.data.id == resource.data.id &&
                      request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId) && isValidId(bookmarkId);
      }

      match /forms/{formDocId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(formDocId) && isValidFormLink(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidId(formDocId) && isValidFormLink(request.resource.data, userId) &&
                      request.resource.data.id == resource.data.id &&
                      request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId) && isValidId(formDocId);
      }
    }
  }
}
